{
  "name": "tacticus-tools",
  "version": "0.1.0",
  "description": "TypeScript types and client for the Tacticus read-only game API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "clean": "rm -rf dist",
    "smoke": "npm run build && node test/client.smoke.mjs",
    "validate": "node test/validate-response.mjs",
    "validate:gamedata": "node test/validate-gamedata.mjs",
    "gamedata:snapshot": "npm run build && node scripts/snapshot-gamedata.mjs",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "validate:stats": "node test/validate-stats.mjs",
    "ui:deploy": "scripts/deploy-pages.sh",
    "validate:plan": "node test/validate-plan.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
